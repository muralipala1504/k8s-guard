# k8s-guard Configuration

# License (PRO-XXXX-YYYY-ZZZZ for pro features)
K8S_GUARD_LICENSE=

# Database path
K8S_GUARD_DB=~/.k8s-guard/history.db

# Check interval (seconds)
K8S_GUARD_CHECK_INTERVAL=10

# Namespace to watch (empty = all)
K8S_GUARD_NAMESPACE=

# Run inside Kubernetes cluster
K8S_GUARD_IN_CLUSTER=false

# Slack webhook for alerts (optional)
SLACK_WEBHOOK_URL=
